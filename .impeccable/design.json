  "narrative": {
    "northStar": "Playful companion",
    "overview": "A friendly companion's study corner: warm pink surroundings, white reading paper, plum ink, and the expressive white puppy. The user selected a softer, more colorful direction while preserving the Bengali, pink, and puppy identity. Pastel introductions make each area welcoming; readable content remains calm enough for timed practice.\n\nThis is a code-led record of the implemented Flutter Android interface, informed by the user-pinned direction in `.impeccable/direction.md`. No approved visual comp exists. Native dimensions use logical pixels (dp) and scalable type (sp); these strings preserve native intent rather than defining CSS. The implementation uses a fixed light scheme. Dark mode is not implemented. Source authority is `lib/core/theme.dart`, `lib/core/study_widgets.dart`, `lib/core/page.dart`, and the feature screens; built-in Material 3 defaults supply styles that are not explicitly overridden.",
    "keyCharacteristics": [
      "Bengali-first bundled HindSiliguri type.",
      "Pink identity, white puppy, and distinct pastel study areas.",
      "Flat reading surfaces with gently rounded controls.",
      "Immediate practice feedback and completion-only celebration.",
      "Safe insets, readable width, and adaptive native navigation."
    ],
    "rules": [
      {
        "name": "The Meaningful State Rule",
        "body": "Pair correctness, selection, bookmark, and review colors with explicit icons or text; color alone must not carry the meaning.",
        "section": "colors"
      },
      {
        "name": "The Bengali Reading Rule",
        "body": "Let text wrap and grow with system text scaling. Do not shrink Bengali copy to keep a decorative panel or fixed row intact.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Keep reading content flat; reserve tonal contrast and borders for hierarchy and meaningful state.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve Bengali copy, the bundled HindSiliguri family, pink identity, and white puppy.",
      "**Do** use safe insets, the 840dp reading cap, adaptive navigation, and controls of at least 48dp.",
      "**Do** keep white reading surfaces quiet and allow Bengali text to wrap at enlarged system text sizes.",
      "**Do** pair state colors with meaningful labels or icons and respect reduced-motion settings."
    ],
    "donts": [
      "**Don't** claim dark-mode support or introduce a second visual identity without a new direction decision.",
      "**Don't** add decorative animation to tab changes or quiz-question navigation.",
      "**Don't** make mascot decoration crowd timed practice, delay answers, or obscure exam feedback.",
      "**Don't** treat the sidecar's browser previews as Flutter source or normative CSS tokens."
    ]
  }
